# mintaka.tj web server — hardened systemd unit.
#
# Install: binary at /opt/mintaka/bin/mintaka-server, site at /opt/mintaka/dist (world-readable),
# secrets in /etc/mintaka/env (mode 0600, root):
#
#   MINTAKA_CONTACT_RECIPIENT=age1…            # the team's age public key
#   MINTAKA_TELEGRAM_BOT_TOKEN=…               # optional
#   MINTAKA_TELEGRAM_CHAT_ID=…                 # optional
#
# Certificates: the server orders and renews them from Let's Encrypt itself (TLS-ALPN-01 on
# 443/tcp — nothing on port 80 is involved) and caches the account key and certificates in
# ${STATE_DIRECTORY}/acme, mode 0600. Renewals are swapped in without a restart. Before the first
# production start, run once with `--acme-directory staging` (README, "Certificates").
# Open 443/tcp, 443/udp (HTTP/3) and 80/tcp in the firewall.
#
# With certificates from elsewhere instead, replace the --acme-* flags with
#   --tls-cert ${CREDENTIALS_DIRECTORY}/fullchain.pem --tls-key ${CREDENTIALS_DIRECTORY}/privkey.pem
# plus LoadCredential=fullchain.pem:/etc/letsencrypt/live/mintaka.tj/fullchain.pem and
# LoadCredential=privkey.pem:/etc/letsencrypt/live/mintaka.tj/privkey.pem, and restart the unit
# after each renewal.
# Check the sandbox with: systemd-analyze security mintaka.service

[Unit]
Description=mintaka.tj web server
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/opt/mintaka/bin/mintaka-server \
    --dist /opt/mintaka/dist \
    --data-dir ${STATE_DIRECTORY} \
    --listen 127.0.0.1:8080 \
    --tls-listen [::]:443 \
    --http3 \
    --acme-domain mintaka.tj \
    --acme-domain www.mintaka.tj \
    --acme-contact mailto:ops@mintaka.tj \
    --redirect-http [::]:80 \
    --region fra-1 \
    --location "Frankfurt,DE,50.1109,8.6821"
EnvironmentFile=-/etc/mintaka/env
Environment=RUST_LOG=info

# Graceful shutdown: SIGTERM, the server drains for up to 10 s.
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=on-failure
RestartSec=2
LimitNOFILE=65536

# Identity and file system. The state directory holds the contact briefs and the ACME cache; it
# must survive restarts (systemd keeps it), or every start orders a new certificate.
DynamicUser=yes
StateDirectory=mintaka
StateDirectoryMode=0700
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid

# Privileges: only binding ports below 1024 (443/tcp, 443/udp, 80/tcp).
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RemoveIPC=yes

# Kernel surface.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# AF_UNIX/AF_NETLINK: the resolver, for outbound HTTPS to the ACME CA and the Telegram API.
# AF_INET/AF_INET6 cover UDP too (HTTP/3).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
