# Offline mode (web/offline/index.ts, web/sw/sw.ts): states shared by every instrument.

offline-status = offline
offline-island = You're offline, and this instrument's code isn't saved on this device yet. It loads by itself when you're back online.
offline-wasm = You're offline, and this instrument's WebAssembly isn't saved on this device yet. It loads by itself when you're back online.
