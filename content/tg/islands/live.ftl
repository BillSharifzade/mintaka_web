## S6 · Live load (web/instruments/live.ts).
## This server's own traffic, one tick per second from GET /_telemetry (Server-Sent Events).
## Aggregates only. Values are filled in live — never put an example number here.

live-connecting = пайваст шуда истодааст
live-live = зинда
live-reconnecting = аз нав пайваст мешавад
live-offline = офлайн
live-paused = таваққуф
# The button that stops and restarts the live updates.
live-pause = Таваққуф
live-resume = Идома
live-unsupported = Ин браузер ҷараёни Server-Sent Events-ро кушода наметавонад, бинобар ин сарбории зинда дар ин ҷо дастрас нест.
live-rps = Дархост дар як сония
live-p50 = Таъхир, медиана
live-p99 = Таъхир, персентили 99-ум
live-p999 = Таъхир, персентили 99,9-ум
live-cpu = CPU, ҳиссаи як ядро
live-rss = Хотираи истифодашаванда (RSS)
live-conns = Пайвастҳои кушода
live-total = Дархостҳо аз лаҳзаи оғоз
live-idle = дархост нест
live-range = аз { $min } то { $max } дар як дақиқаи охир
live-dots = { $n ->
    [1] Ҳар нуқта як дархост аст.
   *[other] Ҳар нуқта { $n } дархост аст.
}
live-server = Сервер { $region } · { $n } ядро · сохт { $build }
live-window = Таъхир 10 сонияи охирро дар бар мегирад; хатҳо 60 сонияи охирро нишон медиҳанд.
live-foot = Танҳо рақамҳои ҷамъбастӣ: суроғаҳои IP, роҳҳо ва user agent-ҳо ҳеҷ гоҳ ба ин ҷараён намерасанд.
live-said-live = Маълумоти зинда пайваст шуд.
live-said-lost = Маълумоти зинда қатъ шуд. Боз кӯшиш мекунем.
live-said-offline = Маълумоти зинда дастрас нест. Дар пасзамина боз кӯшиш мекунем.
