# S4 · Route across Dushanbe (web/instruments/routing). Counts are intersections: what the
# searches actually settle.
routing-status-nowasm = WebAssembly дастрас нест
routing-status-loading = харита бор мешавад
routing-status-failed = бор нашуд
routing-status-ready = дар браузери шумо
routing-route = Масир
routing-mode = Ҳолат
routing-mode-watch = Тамошо
routing-mode-race = Мусобиқа
routing-preset-airport = Аз вокзал то фурудгоҳ
routing-preset-random = Ҷуфти тасодуфӣ
routing-hint = Ё харитаро ду бор ламс кунед: аввал оғоз, баъд мақсад. Масирҳо аз рӯи масофа кӯтоҳтаринанд; кӯчаҳои яктарафа ба ҳисоб гирифта мешаванд.
routing-dijkstra = Дейкстра
routing-dijkstra-what = Ба ҳар тараф паҳн мешавад, то ба мақсад расад.
routing-astar = A*
routing-astar-what = Роҳҳоеро, ки ба сӯи мақсад нигаронида шудаанд, афзалтар медонад, бинобар ин дар дохили конус ҷустуҷӯ мекунад.
routing-ch = Contraction Hierarchies
routing-ch-what = Миёнбурҳои пешакӣ тайёршударо истифода мебарад: ба роҳҳои муҳим мебарояд ва ҷаҳида мегузарад.
routing-explored = Чорроҳаҳои тафтишшуда
routing-time = Вақт барои як масир
routing-speedup = Тезонӣ
routing-baseline = асос
routing-summary = Ҳамон роҳҳо. Ҳамон ҷавоб. { $less } кори камтар.
routing-announce = Масир ёфт шуд: { $km } км. Дейкстра { $d } чорроҳаро тафтиш кард, Contraction Hierarchies — { $c }.
routing-graph = Граф: { $n } чорроҳа, { $arcs } камони роҳ ва { $shortcuts } миёнбур, ки ҳангоми сохт дар Rust омода шудаанд. Вақтҳо медианаи 9 иҷро мебошанд, ки дар ҳамин браузер чен шудаанд.
