## S6 · Overload lab (web/instruments/loadsim/): a simulation, compiled from Rust to WebAssembly
## and run in the visitor's browser. Every number it shows comes from that run — nothing here is
## measured on our servers, and the copy must keep saying so.

loadsim-status = симулятсия
loadsim-loading = бор мешавад
loadsim-nowasm = Ин браузер WebAssembly-ро иҷро карда наметавонад, бинобар ин симулятсия дар ин ҷо оғоз намешавад.
loadsim-failed = Симулятсия бор нашуд, бинобар ин дар ин ҷо чизе барои иҷро нест.
loadsim-load = Сарборӣ
loadsim-load-value = ×{ $x } — { $rate } дархост/с
loadsim-pause = Таваққуф
loadsim-play = Идома
loadsim-reset = Аз нав
loadsim-about = Ин симулятсия аст, на ченкунии ин сомона. Дархостҳо тасодуфӣ меоянд (тақсимоти Пуассон), дар ×1 { $base } дар як сония, ва ҳар кадом ба ҳисоби миёна { $mean } кор талаб мекунад, бо думи дароз (тақсимоти логнормалӣ). Мизоҷон пас аз { $timeout } даст мекашанд ва { $n ->
    [1] як бори дигар
   *[other] { $n } бори дигар
} кӯшиш мекунанд. Ҳарду система айнан ҳамон дархостҳоро мегиранд.
loadsim-naive = Содда
loadsim-naive-about = { $n ->
    [1] Як коргар
   *[other] { $n } коргар
} ва як навбати бемаҳдуд. Ҳар дархост навбати худро интизор мешавад, ҳатто пас аз он ки мизоҷаш даст кашидааст — ва баъд кор барои ҳеҷ кас иҷро мешавад.
loadsim-ours = Бо усули мо
loadsim-ours-about = Бо { $n ->
    [1] як коргар
   *[other] { $n } коргар
} оғоз мекунад; миқёсгири худкор коргарони дигар илова мекунад — то { $max }, ва ҳар кадом барои оғоз { $boot } вақт мегирад. Вақте ки дархостҳо дар давоми { $interval } зиёда аз { $target } дар навбат истоданд, дархостҳои нав фавран ҷавоби 503 мегиранд, ҳамчунин дархостҳои кӯҳна; навбат ҳеҷ гоҳ барои ҳар коргар зиёда аз { $per } дархост нигоҳ намедорад.
loadsim-p99 = Таъхири p99-и ҷавобҳои бомуваффақият
loadsim-none = ҳеҷ кас сари вақт ҷавоб нагирифт
loadsim-served = Сари вақт ҷавоб дода шуд, аз омадаҳо
loadsim-served-value = { $good } аз { $offered }/с
loadsim-refused = Рад шуд (503) · мӯҳлат гузашт
loadsim-refused-value = { $shed } · { $timeouts }/с
loadsim-state = Навбат ва коргарон
loadsim-waiting = { $n } дархост дар навбат
loadsim-busy = { $busy } аз { $n } коргар банд
loadsim-starting = { $n } оғоз мешавад
loadsim-wasted = { $n }/с кор барои мизоҷоне, ки аллакай даст кашидаанд
loadsim-limit = (ҳадди симулятсия)
loadsim-little = { $l } дар система ≈ { $lambda }/с × { $w } = { $lw }
loadsim-little-about = Қонуни Литл: шумораи миёнаи дархостҳо дар система ба суръати баромадани онҳо зарб дар вақте, ки ҳар кадом дар он мемонад, баробар аст. Ҳар се бузургӣ дар 4 сонияи охир алоҳида чен карда мешаванд; онҳо то вақте мувофиқанд, ки система устувор аст, ва вақте ки навбаташ меафзояд ё холӣ мешавад, аз ҳам ҷудо мешаванд.
loadsim-legend = Графикҳо дақиқаи охирро дар ҳарду лавҳа бо ҳамон миқёс нишон медиҳанд. Таъхир дар миқёси логарифмӣ аз 10 мс то 10 с аст; хати штрихӣ мӯҳлати { $timeout }-и мизоҷон аст. Барои маҳдуд кардани хотира навбати содда дар { $cap } дархости интизор қатъ мешавад; баъд аз он дархостҳои нав гум мешаванд ва мӯҳлати мизоҷонашон мегузарад.
loadsim-try = ×40-ро ним дақиқа санҷед, баъд ба ×1 баргардед: системаи содда то он даме хобида мемонад, ки дархостҳоеро, ки дигар касе интизор нест, ба анҷом нарасонад.
