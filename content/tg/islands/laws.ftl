## S7 · Laws you can feel (web/instruments/laws/). Three optional experiments; every measurement
## stays in the visitor's browser. Results are filled in live — never put an example number here.

laws-status = дар ҳамин дастгоҳ
laws-tabs = Таҷрибаҳо
laws-fitts = Қонуни Фиттс
laws-hick = Қонуни Хик — Ҳайман
laws-pop = Ҷустуҷӯи фарқ
laws-start = Оғоз
laws-again = Боз як бор
laws-count = { $n } аз { $total }
laws-misses = { $n } хато
laws-local = Дар ҳамин дастгоҳ аз рӯи кликҳо, ламсҳо ва пахши тугмаҳои худи шумо чен шуд. Ҳеҷ чиз ба ҳеҷ ҷо фиристода намешавад: ин асбоб ягон дархости шабакавӣ намекунад.
laws-hidden = Қатъ шуд: варақа пинҳон шуд ва ин вақтсанҷиро вайрон мекард. Вақте ки омода бошед, аз нав оғоз кунед.
laws-results = Рақамҳои шумо
laws-not-run = Ҳанӯз иҷро нашудааст.
laws-data = Кӯшишҳои шумо
laws-col-n = Интихобҳо
laws-col-ms = Вақт, мс
laws-a = Аъзои озоди a
laws-b = Нишебии b
laws-r2 = Мувофиқат, R²
laws-tp = Қобилияти гузарониш
laws-shapes-cue = Ин шаклро ёбед:

laws-fitts-intro = Ба 15 ҳадафи андоза ва масофаи гуногун ҳарчи зудтар занед. Тақрибан 20 сония, бо муш, ангушт ё қалам.
laws-fitts-keys = Ин таҷриба ишоракуниро чен мекунад, бинобар ин ишоракунак лозим аст. Бо клавиатура ду таҷрибаи дигар пурра кор мекунанд.
laws-fitts-skip = Ба қонуни Хик — Ҳайман гузаред
laws-fitts-go = Барои оғоз доираро клик ё ламс кунед
laws-fitts-x = Душворӣ (ID), бит
laws-fitts-plain = Ҳар бити иловагии душворӣ — тақрибан ду баробар масофаи дуртар ё ду баробар андозаи хурдтар — ба дасти шумо { $b } арзид.
laws-fitts-line = Дасти шумо ҳозир ба муодилаи соли 1954 итоат кард. Тугмаҳои мо бо он андоза гирифта мешаванд.
laws-fitts-loose = Ин дафъа мувофиқат суст аст. Иҷрои дуюм одатан онро дақиқтар мекунад.

laws-hick-intro = Шакли мувофиқро аз 2, 4 ё 8 интихоб ёбед — онро клик ё ламс кунед, рақамашро пахш кунед ё бо тугмаҳои тирча ҳаракат карда, Enter-ро пахш кунед. 24 даври зуд, тақрибан 30 сония.
laws-hick-block = { $n } интихоб
laws-hick-x = Интихоб, log2(n + 1), бит
laws-hick-plain = Ҳар бити иловагии интихоб — тақрибан ду баробар шудани интихобҳо — ба шумо { $b } арзид.
laws-hick-line = Ҳар интихоби иловагӣ ба шумо миллисонияҳо арзид. Барои ҳамин менюҳои мо кӯтоҳанд.
laws-hick-flat = Дар ин иҷро сустшавӣ дида нашуд. Боз кӯшиш кунед, каме тезтар.

laws-pop-intro = Ситораи фарқкунандаро дар байни 60 ситора ёбед ва онро клик ё ламс кунед — ё чоряки майдонро бо рақамҳои 1 то 4 пахш кунед, ё бо тугмаҳои тирча ҳаракат карда, Enter-ро пахш кунед. Се давр: аз рӯи ранг, аз рӯи шакл, баъд ҳардуяш. Тақрибан 25 сония.
laws-pop-area = Майдони ҷустуҷӯ. Бо рақами чоряке, ки ситораи фарқкунанда дар он аст, ҷавоб диҳед: 1 — болои чап, 2 — болои рост, 3 — поёни чап, 4 — поёни рост, ё бо тугмаҳои тирча ва Enter.
laws-pop-colour = Ранг
laws-pop-shape = Шакл
laws-pop-both = Ранг ва шакл
laws-pop-both-short = Ҳардуяш
laws-pop-plain = Ёфтани ранг ва шакл якҷоя ба шумо { $x } бештар аз ёфтани танҳо ранг вақт гирифт.
laws-pop-line = Ранг чизҳоро барои шумо меёбад. Барои ҳамин мо ранги зангро хеле кам истифода мебарем: он танҳо Бетелгейзе ва тугмаеро, ки лоиҳаро оғоз мекунад, нишон медиҳад.
laws-wrong = { $n } ҷавоби нодуруст

laws-shape-circle = доира
laws-shape-ring = ҳалқа
laws-shape-square = мураббаъ
laws-shape-triangle = секунҷа
laws-shape-diamond = ромб
laws-shape-plus = аломати ҷамъ
laws-shape-cross = аломати зарб
laws-shape-hexagon = шашкунҷа
