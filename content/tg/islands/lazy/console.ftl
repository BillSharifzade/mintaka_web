# DevTools console (web/console/index.ts): the lines mintaka.help() prints, in a lazy bundle
# fetched when it is first called (/assets/strings/console.<lang>.<hash>.json).

console-help-help = ҳамин рӯйхат
console-help-proof = /_proof-ро гирифта, дар консол нишон додан
console-help-terminal = кушодани терминал (ё ~-ро пахш кунед)
console-help-version = сохти ин сомона, аз рӯи /_proof
console-help-ctf = оғози озмоиши консол: чор муаммо, баъд варақаи ариза
console-help-flag = санҷидани ҷавоб ба муаммои ҷорӣ
console-help-apply = варақаи ариза, пас аз ҳалли ҳар чор муаммо
